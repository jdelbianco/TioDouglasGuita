FROM node:24-alpine AS build

WORKDIR /app

COPY . .

ARG APP_WORKSPACE
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm ci \
    && npm run build --workspace=${APP_WORKSPACE} \
    && case "${APP_WORKSPACE}" in \
        "@douglasguita/frontend-aluno") app_dir="apps/frontend-aluno" ;; \
        "@douglasguita/frontend-professor") app_dir="apps/frontend-professor" ;; \
        *) echo "Unsupported APP_WORKSPACE: ${APP_WORKSPACE}" >&2; exit 1 ;; \
    esac \
    && mkdir -p /app/frontend-dist \
    && cp -R "/app/${app_dir}/dist/." /app/frontend-dist/

FROM nginx:alpine

COPY frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend-dist/ /usr/share/nginx/html/

EXPOSE 80
